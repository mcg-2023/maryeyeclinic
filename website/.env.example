# Set these as server environment variables. Never put API keys in dist/.
# Node 24+: node server.cjs (.env is loaded automatically)
OPENAI_API_KEY=
OPENAI_MODEL=
PORT=4173
# Required for administrator login, including local preview.
# Use a unique password. Production hosting must use HTTPS.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional persistent SQLite path. Default: website/.data/posts.sqlite
# PAGE_MANAGER_DB=
